#!/usr/bin/env bash
set -euo pipefail

if [ "${SKIP_MEDIA:-0}" = "1" ]; then
  exit 0
fi

local_ver=$(sed -n 's/^version = "\([^"]*\)"/\1/p' pyproject.toml | head -n1)
need_media=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [[ "$remote_ref" == refs/tags/v* ]]; then
    need_media=1
    break
  fi
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && \
     git cat-file -e "$remote_sha:pyproject.toml" 2>/dev/null; then
    remote_ver=$(git show "$remote_sha:pyproject.toml" | sed -n 's/^version = "\([^"]*\)"/\1/p' | head -n1)
    if [ "$local_ver" != "$remote_ver" ]; then
      need_media=1
      break
    fi
  fi
done

if [ "$need_media" -eq 0 ]; then
  exit 0
fi

echo "pre-push: version changed ($local_ver); verifying README media assets..."
python3 scripts/media_release.py check
python3 scripts/media_release.py upload
